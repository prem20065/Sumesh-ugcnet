    "lint": "eslint src tests",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pdfjs-dist": "4.4.168"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
